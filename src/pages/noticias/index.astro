---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
---

<Layout title="Noticias">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-center mb-8 text-gray-800">Noticias</h1>

    <ul class="space-y-6">
      {
        posts.map((post) => (
          <li class="p-6 bg-white shadow-lg rounded-lg hover:shadow-xl transition-shadow duration-300">
            <a
              href={`/noticias/${post.slug}/`}
              class="text-2xl font-semibold text-blue-600 hover:text-blue-800"
            >
              {post.title}
            </a>
            {post.published_at && (
              <p class="mt-2 text-gray-600">
                {new Date(post.published_at).toLocaleDateString()} &bull;{" "}
                {post.primary_author?.name}
              </p>
            )}
            {post.excerpt && post.excerpt.length > 0 && (
              <div class="space-y-8">
                {post.html && (
                  <Fragment set:html={post.excerpt.slice(0, 100)} />
                )}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
