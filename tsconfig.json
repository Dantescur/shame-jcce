{
  "extends": "astro/tsconfigs/strict",
  // "include": [
  //   ".astro/types.d.ts",
  //   "**/*"
  // ],
  // "exclude": [
  //   "dist"
  // ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "./src",
    "paths": {
      "@components/*": [
        "components/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@interfaces/*": [
        "interfaces/*"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@utils/*": [
        "utils/*"
      ]
    }
  }
}